<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Chats</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>

    <h1>All Chats</h1>
     <form action="/chats/new" method="GET">
    <button type="submit">New Chat</button>
     </form>
    <div class="container">
        <% chats.forEach((chat) => { %>

            <div class="chat-card">
                <div class="chat-header">
                    <span class="from"><%= chat.from %></span>
                    <span class="arrow">➜</span>
                    <span class="to"><%= chat.to %></span>
                </div>

                <div class="message">
                    <%= chat.msg %>
                    <form method="GET"  action="/chats/<%=chat.id%>/edit">
                        <button>Edit</button>
                    </form>
                    <br>
                    <form method="POST"  action="/chats/<%=chat.id%>?_method=DELETE">
                        <button>Delete</button>
                    </form>
                </div>

                <div class="time">
                    <%= chat.created_at.toLocaleString() %>
                </div>
            </div>

        <% }) %>
         
    </div>

</body>
</html>